{
  "name": "ssh-heaven",
  "version": "0.11.1",
  "private": true,
  "description": "A focused desktop SSH terminal and SFTP workspace.",
  "author": "SSH Heaven",
  "license": "UNLICENSED",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "node scripts/run.mjs dev",
    "start": "node scripts/run.mjs preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build && node scripts/build-mcp.mjs",
    "predev": "node scripts/build-mcp.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx tests/e2e.ts",
    "test:workspace": "tsx tests/home-keygen.e2e.ts",
    "test:themes": "tsx tests/themes.e2e.ts",
    "test:productivity": "tsx tests/productivity.e2e.ts",
    "test:chrome": "tsx tests/window-chrome.e2e.ts",
    "test:fleet": "tsx tests/fleet.e2e.ts",
    "test:tools": "tsx tests/workspace-tools.e2e.ts",
    "test:management": "tsx tests/management.e2e.ts",
    "test:folders": "tsx tests/folders.e2e.ts",
    "test:mcp": "tsx tests/mcp.e2e.ts",
    "test:terminal": "tsx tests/terminal-layout.e2e.ts",
    "test:wallpaper": "tsx tests/wallpaper.e2e.ts",
    "test:quick-connect": "tsx tests/quick-connect.e2e.ts",
    "test:input": "tsx tests/input-latency.e2e.ts",
    "test:stream": "tsx tests/stream-terminal.e2e.ts",
    "test:scripts": "tsx tests/scripts.e2e.ts",
    "test:vault": "tsx tests/vault.e2e.ts",
    "test:navigation": "tsx tests/navigation.e2e.ts",
    "test:updates": "tsx tests/updates.e2e.ts",
    "test:release-suggestion": "tsx tests/release-suggestion.e2e.ts",
    "test:defaults": "tsx tests/connection-defaults.e2e.ts",
    "test:drag": "tsx tests/window-drag.e2e.ts",
    "test:packaged": "node scripts/test-packaged.mjs",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win:signed": "node scripts/release-win.mjs",
    "test:qol": "tsx tests/qol.e2e.ts",
    "test:file-workflow": "tsx tests/file-workflow.e2e.ts",
    "test:transfer-qol": "tsx tests/transfer-qol.e2e.ts",
    "test:release-download": "tsx tests/release-download.e2e.ts",
    "test:multi-session": "tsx tests/multi-session-performance.e2e.ts",
    "test:editor-performance": "tsx tests/editor-performance.e2e.ts"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@uiw/react-codemirror": "^4.25.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "gifuct-js": "^2.1.2",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
  },
  "build": {
    "appId": "com.sshheaven.desktop",
    "productName": "SSH Heaven",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "package.json",
      "build/release-config.json"
    ],
    "extraResources": [
      {
        "from": "build/mcp",
        "to": "mcp",
        "filter": [
          "bridge.cjs"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
